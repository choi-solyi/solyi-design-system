{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "types": [
      "vite/client",
      "solyi-ui/global"
    ]
  },
  "vueCompilerOptions": {
    "strictTemplates": true,
    "checkUnknownProps": false
  },
  "include": [
    "src/AdvancedExamples.vue",
    "src/RecipeExamples.vue",
    "src/recipe-registry.ts",
    "src/inline-previews.ts",
    "src/recipes/*.vue",
    "src/auto-imports.d.ts"
  ]
}
