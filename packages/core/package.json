{
  "name": "@solyi/core",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Internal framework-independent Solyi tokens, CSS and runtime sources included in solyi-ui.",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.css": "./dist/components.css",
    "./overflow": {
      "types": "./dist/overflow.d.ts",
      "import": "./dist/overflow.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./date": {
      "types": "./dist/date-only.d.ts",
      "import": "./dist/date-only.js"
    },
    "./fonts.css": "./dist/fonts/wanted-sans/WantedSansVariable.css",
    "./code-fonts.css": "./dist/fonts/code-fonts.css",
    "./DESIGN.md": "./DESIGN.md"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --core",
    "prepack": "node ../../scripts/prepare-package.mjs core"
  }
}
