{
  "name": "@solyi/core",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Framework-independent Solyi tokens and CSS. Local pack preview; not published.",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./components.css": "./dist/components.css",
    "./overflow": {
      "types": "./dist/overflow.d.ts",
      "import": "./dist/overflow.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./date": {
      "types": "./dist/date-only.d.ts",
      "import": "./dist/date-only.js"
    },
    "./fonts.css": "./dist/fonts/wanted-sans/WantedSansVariable.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs --core"
  }
}
