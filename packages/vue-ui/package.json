{
  "name": "@solyi/vue-ui",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Typed S-named Vue components and reusable documented recipes. Private local pack preview.",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./DESIGN.md": "./DESIGN.md"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@solyi/core": "0.4.4",
    "vue": ">=3.5.44 <3.6.0",
    "vuetify": ">=4.3.0 <4.4.0"
  },
  "devDependencies": {
    "@solyi/core": "file:../core",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue": "3.5.44",
    "vuetify": "4.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && node ../../scripts/finalize-vue-package.mjs"
  }
}
