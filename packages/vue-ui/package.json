{
  "name": "solyi-ui",
  "version": "0.10.4",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Vue 3용 S 컴포넌트, 디자인 토큰, CSS 및 공통 도구를 제공하는 UI 라이브러리.",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./global": {
      "types": "./dist/global.d.ts",
      "import": "./dist/global.js"
    },
    "./DESIGN.md": "./DESIGN.md",
    "./tokens": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./tokens.css": "./dist/core/tokens.css",
    "./tokens.json": "./dist/core/tokens.json",
    "./components.css": "./dist/core/components.css",
    "./fonts.css": "./dist/core/fonts/wanted-sans/WantedSansVariable.css",
    "./code-fonts.css": "./dist/core/fonts/code-fonts.css",
    "./date": {
      "types": "./dist/core/date-only.d.ts",
      "import": "./dist/core/date-only.js"
    },
    "./icons": {
      "types": "./dist/core/icons.d.ts",
      "import": "./dist/core/icons.js"
    },
    "./overflow": {
      "types": "./dist/core/overflow.d.ts",
      "import": "./dist/core/overflow.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": ">=3.5.44 <3.6.0",
    "vuetify": ">=4.3.0 <4.4.0"
  },
  "devDependencies": {
    "@solyi/core": "file:../core",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vue": "3.5.44",
    "vuetify": "4.3.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "build": "node ../../scripts/build-vue-version.mjs && vite build && tsc -p tsconfig.json && node ../../scripts/finalize-vue-package.mjs"
  }
}
